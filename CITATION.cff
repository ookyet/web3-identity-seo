    alias: "ookyet.eth"
    website: "https://ookyet.com"
repository-code: "https://github.com/ookyet/web3-identity-seo"
url: "https://ookyet.com/proof/"
license: MIT
keywords:
  - web3-identity
  - ens
  - structured-data
  - schema-org
  - entity-seo
  - knowledge-graph
